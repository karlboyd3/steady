# Root domain tenants hang subdomains off of (e.g. clinic.getsteady.app).
NEXT_PUBLIC_ROOT_DOMAIN=getsteady.app

# Supabase project backing the `tenants` table. Server-only — never NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random string gating /admin (Setup: `openssl rand -hex 32`).
ADMIN_TOKEN=
